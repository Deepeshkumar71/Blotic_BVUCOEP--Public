# 🔐 BLOTIC Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (Required)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Settings
VITE_APP_TITLE=BLOTIC
VITE_APP_DESCRIPTION=Bharati Vidyapeeth's Premier Blockchain & Web3 Club
VITE_APP_VERSION=1.0.0

# Environment Configuration
NODE_ENV=development
VITE_DEBUG=true
VITE_API_BASE_URL=http://localhost:3000

# Production Settings (for Vercel deployment)
VITE_PRODUCTION_URL=https://blotic-bvucoep.vercel.app
VITE_CUSTOM_DOMAIN=blotic-bvucoep.vercel.app

# Security Settings
VITE_ENABLE_RATE_LIMITING=true
VITE_MAX_LOGIN_ATTEMPTS=10
VITE_RATE_LIMIT_WINDOW=900000

# Email Configuration (for password reset emails)
# To send real emails, set up Gmail App Password:
# 1. Enable 2FA on Gmail
# 2. Generate App Password in Google Account settings
# 3. Use your Gmail and the 16-character app password below
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# Alternative Email Options:
# Web3Forms (Free) - Get your key from web3forms.com
# REACT_APP_WEB3FORMS_KEY=your-web3forms-key

# EmailJS with Gmail (Recommended)
# REACT_APP_EMAILJS_SERVICE_ID=service_your_id
# REACT_APP_EMAILJS_TEMPLATE_ID=template_your_id
# REACT_APP_EMAILJS_PUBLIC_KEY=user_your_key

# Optional: Analytics & Monitoring
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn
# VITE_HOTJAR_ID=your_hotjar_id

# Optional: Social Media Links
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/blotic_bvucoep
# VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/blotic
# VITE_SOCIAL_TWITTER=https://twitter.com/blotic_bvucoep
# VITE_SOCIAL_GITHUB=https://github.com/blotic-bvucoep

# Optional: External Services
# VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Database Configuration (for advanced features)
# DATABASE_URL=postgresql://user:password@localhost:5432/blotic
# REDIS_URL=redis://localhost:6379

# Webhook Configuration
# WEBHOOK_SECRET=your_webhook_secret_key
# SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret