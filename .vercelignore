# Vercel Ignore File
# Files and directories to exclude from Vercel deployment

# Development files
.env.local
.env.development
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
.cache/
.parcel-cache/

# Development dependencies
node_modules/
.pnpm-store/

# Test files
tests/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage/
.nyc_output/

# Build artifacts (keep dist for deployment)
.turbo/
next/
.nuxt/

# Documentation (deploy with project)
# README.md
# docs/

# Source maps (include for better debugging)
# *.map

# Local server files
server/
scripts/generate-photo-gallery.cjs

# Git files
git/
gitignore

# Package manager files (keep package-lock.json for npm)
yarn.lock
pnpm-lock.yaml

# Environment templates (keep .env.example)
.env.example/
