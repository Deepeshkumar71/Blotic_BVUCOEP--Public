# Blotic BVUCOEP - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# LOCAL DEVELOPMENT (when running supabase start)
# =============================================================================
# Get these values by running: supabase status
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=your-local-anon-key-here

# =============================================================================
# PRODUCTION/STAGING SUPABASE
# =============================================================================
# Get these from your Supabase dashboard: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# EMAIL CONFIGURATION (Choose one option)
# =============================================================================

# Option 1: EmailJS (Recommended - No backend required)
REACT_APP_EMAILJS_SERVICE_ID=service_abc123
REACT_APP_EMAILJS_TEMPLATE_ID=template_xyz789
REACT_APP_EMAILJS_PUBLIC_KEY=user_def456

# Option 2: Custom SMTP (Requires backend implementation)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =============================================================================
# OPTIONAL: THIRD-PARTY SERVICES
# =============================================================================

# OpenAI (for AI features)
# OPENAI_API_KEY=sk-your-openai-api-key

# Analytics (if using)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Set to 'development' for local dev, 'production' for live
NODE_ENV=development

# Enable debug logging (true/false)
VITE_DEBUG=true
